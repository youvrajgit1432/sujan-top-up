# ============================================================
# Sujan Top-Up - example environment configuration
# Copy to .env and adjust for your machine.
# ============================================================

# ---- Application ----
APP_NAME="Sujan Top-Up"
APP_URL=http://localhost/sujan
APP_ENV=local
APP_DEBUG=true

# ---- Database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sujan_topup_demo
DB_USER=root
DB_PASSWORD=

# ---- Public demo contact details (placeholders only) ----
SUPPORT_EMAIL=demo@example.test
SUPPORT_PHONE=9779800000000
WHATSAPP_NUMBER=9779800000000
PAYMENT_INSTRUCTIONS="Configure your payment account in local settings."

# ---- Email / SMTP (optional) ----
# Leave blank to run the demo without email. OTP and password reset will
# degrade gracefully and tell the user email delivery is not configured.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME="Sujan Top-Up"
